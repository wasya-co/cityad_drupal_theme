function cityad_drupal_theme_preprocess_node(array &$variables) {
  $node = $variables['node'];

  if ($variables['view_mode'] == 'full') {
    if ($node->hasField('field_image_hero')) {

      $field_image_hero = $node->get('field_image_hero');
      $image_hero = NULL;
      if (!$field_image_hero->isEmpty()) {
        $image_hero = $field_image_hero->entity;
      } else {
        $definition = $field_image_hero->getFieldDefinition();
        $default_image = $definition->getSetting('default_image');
        if (empty($default_image['uuid']) && $definition instanceof FieldConfigInterface) {
          $default_image = $definition->getFieldStorageDefinition()->getSetting('default_image');
        }
        if (!empty($default_image['uuid'])) {
          $image_hero = \Drupal::service('entity.repository')->loadEntityByUuid('file', $default_image['uuid']);
        }
      }
      if ($image_hero) {
        $variables['image_hero_url'] = \Drupal::service('file_url_generator')
          ->generateString($image_hero->getFileUri());
      }

    }
  }
}

/*
 * Implements hook_preprocess_HOOK() for page templates.
**/
function cityad_drupal_theme_preprocess_page(array &$variables) {
  $config = \Drupal::config('cityad_drupal_theme.settings');
  $libraries = $config->get('load_libraries') ?? [];
  foreach ($libraries as $library => $value) {
    if ($value) {
      $attachments['#attached']['library'][] = "cityad_drupal_theme/{$library}";
    }
  }

  $variables['theme_custom_css'] = theme_get_setting('field_custom_css');

  $footer_image_hero = theme_get_setting('footer_image_hero');
  if ($footer_image_hero) {
    if (is_array($footer_image_hero)) {
      $footer_image_hero = reset($footer_image_hero);
    }
    $file = \Drupal\file\Entity\File::load($footer_image_hero);
    if ($file) {
      $variables['footer_image_hero'] = $file->createFileUrl();
    }
  }
}
