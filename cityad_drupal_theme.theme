<?php

/**
 * @file
 * Functions to support theming in the CityAd Drupal Theme.
 */

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function cityad_drupal_theme_preprocess_page(array &$variables) {
  if (theme_get_setting('fancy_header')) {
    $variables['#attached']['library'][] = 'ish_drupal_module/fancy_header';
  }
}
