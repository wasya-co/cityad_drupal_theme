<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\field\FieldConfigInterface;


/*
**/
function cityad_drupal_theme_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {

  $form['load_libraries'] = [
    '#type' => 'checkboxes',
    '#title' => t('Load libraries'),
    '#options' => [
      'colors_irowor' => 'colors_irowor',
      'custom_mavericks' => 'custom_mavericks',
    ],
    '#default_value' => theme_get_setting('load_libraries') ?? [],
    '#description' => t('Selected libraries will be loaded on all pages.'),
  ];

  $form['field_custom_css'] = [
    '#type' => 'textarea',
    '#title' => t('Custom CSS'),
    '#default_value' => theme_get_setting('field_custom_css'),
    '#description' => t('Custom CSS for this theme.'),
  ];

  $form['logo_dol'] = [
    '#type' => 'managed_file',
    '#title' => t('Logo DOL image'),
    '#upload_location' => 'public://theme/logo',
    '#default_value' => theme_get_setting('logo_dol'),
    '#upload_validators' => [
      'FileExtension' => [
        'extensions' => 'png jpg jpeg webp svg',
      ],
    ],
  ];

  $form['logo_lod'] = [
    '#type' => 'managed_file',
    '#title' => t('Logo LOD image'),
    '#upload_location' => 'public://theme/logo',
    '#default_value' => theme_get_setting('logo_lod'),
    '#upload_validators' => [
      'FileExtension' => [
        'extensions' => 'png jpg jpeg webp svg',
      ],
    ],
  ];

  $form['footer_image_hero'] = [
    '#type' => 'managed_file',
    '#title' => t('Footer hero image'),
    '#upload_location' => 'public://theme/footer',
    '#default_value' => theme_get_setting('footer_image_hero'),
    '#upload_validators' => [
      'FileExtension' => [
        'extensions' => 'png jpg jpeg webp',
      ],
    ],
  ];

  $form['#submit'][] = 'cityad_drupal_theme_settings_submit';
}


function cityad_drupal_theme_settings_submit($form, FormStateInterface $form_state) {
  $file_settings = ['logo_dol', 'logo_lod', 'footer_image_hero'];
  foreach ($file_settings as $setting) {
    $file_ids = $form_state->getValue($setting);
    if (!empty($file_ids)) {
      $file_id = reset($file_ids);
      $file = \Drupal\file\Entity\File::load($file_id);
      if ($file) {
        $file->setPermanent();
        $file->save();
      }
    }
  }
}

/**
 * Helper to resolve a theme-managed file setting to a URL.
 */
function cityad_drupal_theme_get_managed_file_url($setting_name) {
  $file_id = theme_get_setting($setting_name);
  if (!$file_id) {
    return NULL;
  }
  if (is_array($file_id)) {
    $file_id = reset($file_id);
  }
  $file = \Drupal\file\Entity\File::load($file_id);
  if ($file) {
    return $file->createFileUrl();
  }
  return NULL;
}

/**
 * Implements hook_preprocess_HOOK() for block__system_branding_block.
 */
function cityad_drupal_theme_preprocess_block__system_branding_block(array &$variables) {
  $variables['logo_dol'] = cityad_drupal_theme_get_managed_file_url('logo_dol');
  $variables['logo_lod'] = cityad_drupal_theme_get_managed_file_url('logo_lod');
}




function cityad_drupal_theme_preprocess_node(array &$variables) {
  $node = $variables['node'];

  // for sidebar of articles, correcting NOT showing title of main node on page.
  if ($variables['view_mode'] === 'full' && node_is_page($variables['node'])) {
    $variables['page'] = TRUE;
  }

  if ($variables['view_mode'] == 'full') {
    if ($node->hasField('field_image_hero')) {

      $field_image_hero = $node->get('field_image_hero');
      $image_hero = NULL;
      if (!$field_image_hero->isEmpty()) {
        $image_hero = $field_image_hero->entity;
      } else {
        $definition = $field_image_hero->getFieldDefinition();
        $default_image = $definition->getSetting('default_image');
        if (empty($default_image['uuid']) && $definition instanceof FieldConfigInterface) {
          $default_image = $definition->getFieldStorageDefinition()->getSetting('default_image');
        }
        if (!empty($default_image['uuid'])) {
          $image_hero = \Drupal::service('entity.repository')->loadEntityByUuid('file', $default_image['uuid']);
        }
      }
      if ($image_hero) {
        $variables['image_hero_url'] = \Drupal::service('file_url_generator')
          ->generateString($image_hero->getFileUri());
      }

    }
  }
}

/*
 * Implements hook_preprocess_HOOK() for page templates.
**/
function cityad_drupal_theme_preprocess_page(array &$variables) {
  $config = \Drupal::config('cityad_drupal_theme.settings');
  $libraries = $config->get('load_libraries') ?? [];
  foreach ($libraries as $library => $value) {
    if ($value) {
      $attachments['#attached']['library'][] = "cityad_drupal_theme/{$library}";
    }
  }

  $variables['theme_custom_css'] = theme_get_setting('field_custom_css');

  $variables['footer_image_hero'] = cityad_drupal_theme_get_managed_file_url('footer_image_hero');
}
